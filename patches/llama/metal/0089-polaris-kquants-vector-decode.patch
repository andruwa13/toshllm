+// The decode mat-vecs hand each lane 32 contiguous activations, or eight in a strided group.
+// Four 32-bit elements per 128-bit load quarters the load count; every offset used with these
+// is a whole number of 32-weight groups into an f32 row, so the address is 16-byte aligned on
+// both wave32 and wave64.
+inline void mv_ld_f32x32(device const float * p, thread float * d) {
+    FOR_UNROLL (short i = 0; i < 8; ++i) {
+        const float4 t = *(device const float4 *) (p + 4*i);
+        d[4*i + 0] = t.x;
+        d[4*i + 1] = t.y;
+        d[4*i + 2] = t.z;
+        d[4*i + 3] = t.w;
+    }
+}
+
+inline void mv_ld_f32x16(device const float * p, thread float * d) {
+    FOR_UNROLL (short i = 0; i < 4; ++i) {
+        const float4 t = *(device const float4 *) (p + 4*i);
+        d[4*i + 0] = t.x;
+        d[4*i + 1] = t.y;
+        d[4*i + 2] = t.z;
+        d[4*i + 3] = t.w;
+    }
+}
+
+inline void mv_ld_f32x8(device const float * p, thread float * d) {
+    FOR_UNROLL (short i = 0; i < 2; ++i) {
+        const float4 t = *(device const float4 *) (p + 4*i);
+        d[4*i + 0] = t.x;
+        d[4*i + 1] = t.y;
+        d[4*i + 2] = t.z;
+        d[4*i + 3] = t.w;
+    }
+}
+
+inline void mv_ld_f32x8x2(device const float * p, thread float * d) {
+    FOR_UNROLL (short i = 0; i < 4; ++i) {
+        const float2 t = *(device const float2 *) (p + 2*i);
+        d[2*i + 0] = t.x;
+        d[2*i + 1] = t.y;
+    }
+}
